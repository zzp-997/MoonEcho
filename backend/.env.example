# 回声（Echo）后端环境变量配置模板
# 复制此文件为 .env.development / .env.test / .env.production 并填入真实值
# 注意：所有 .env.* 文件已在 .gitignore 中排除，切勿提交包含真实密钥的配置文件

APP_ENV=development
DEBUG=true
DATABASE_URL=mysql+aiomysql://root:HowtoaiRoot2024Secure@118.25.182.15:3306/moonecho
REDIS_URL=redis://:Moonecho2024@118.25.182.15:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MOCK_ENABLED=true
SMS_PROVIDER=mock
CONTENT_AUDIT_PROVIDER=pass
STORAGE_PROVIDER=local
PUSH_PROVIDER=mock

# AI 服务配置
# AI_PROVIDER: 可选 mock（开发默认）/ glm_free（免费用户）/ glm（付费用户）
AI_PROVIDER=mock
# ZHIPU_API_KEY: 智谱 AI API Key，申请地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=
# AI_DAILY_LIMIT: 免费用户每日对话限制
AI_DAILY_LIMIT=10
# AI_DAILY_LIMIT_VIP: VIP 用户每日对话限制
AI_DAILY_LIMIT_VIP=100
