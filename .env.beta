# ============================================================
# 回声（Echo Meet）公测环境配置
# 用途：100-200人公测环境
# 使用：cp .env.beta .env && docker compose up -d --build
# 配置策略：MinIO + 本地关键词过滤 + 极光免费额度 + GLM免费额度
# ============================================================

# ----------------------------------------------------------
# 环境设置
# ----------------------------------------------------------
# APP_ENV 是 config.py 加载 .env.{APP_ENV} 文件的关键变量
APP_ENV=beta
ENV=beta
DEBUG=false

# ----------------------------------------------------------
# MySQL 配置
# ----------------------------------------------------------
MYSQL_ROOT_PASSWORD=echo_beta_root_2026
MYSQL_USER=echo_app
MYSQL_PASSWORD=echo_beta_app_2026
MYSQL_PORT=3306

# ----------------------------------------------------------
# Redis 配置
# ----------------------------------------------------------
REDIS_PASSWORD=echo_beta_redis_2026
REDIS_PORT=6379

# ----------------------------------------------------------
# JWT 配置
# 公测环境必须使用强密钥
# 生成方式：openssl rand -hex 32
# ----------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# 匿名身份加密密钥
# 公测环境必须配置
# ----------------------------------------------------------
ANON_MAPPING_ENCRYPTION_KEY=CHANGE_ME_GENERATE_ANOTHER_KEY

# ----------------------------------------------------------
# MinIO 配置（公测环境对象存储）
# ----------------------------------------------------------
MINIO_ROOT_USER=echo_beta_minio
MINIO_ROOT_PASSWORD=echo_beta_minio_2026
MINIO_BUCKET=echo-meet-beta
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----------------------------------------------------------
# API 配置
# ----------------------------------------------------------
API_PORT=8000
API_WORKERS=4

# ----------------------------------------------------------
# Nginx 配置
# ----------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ----------------------------------------------------------
# Uptime Kuma 配置
# ----------------------------------------------------------
UPTIME_KUMA_PORT=3001

# ----------------------------------------------------------
# 数据库连接（由 docker-compose 自动设置，此处仅作参考）
# ----------------------------------------------------------
DATABASE_URL=mysql+aiomysql://echo_app:echo_beta_app_2026@mysql:3306/echo_meet
REDIS_URL=redis://:echo_beta_redis_2026@redis:6379/0

# ----------------------------------------------------------
# 第三方服务配置（公测环境使用免费额度）
# ----------------------------------------------------------

# 智谱 AI（公测使用 GLM 免费额度）
ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY_HERE

# 阿里云 OSS（公测环境使用 MinIO 替代，无需配置）
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_ENDPOINT=

# 阿里云短信（公测暂时使用 mock，验证码在后台日志查看）
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=

# 阿里云内容安全（公测使用本地关键词过滤，无需配置）
# ALIYUN_CONTENT_AUDIT_ACCESS_KEY_ID=
# ALIYUN_CONTENT_AUDIT_ACCESS_KEY_SECRET=

# 极光推送（公测使用免费额度）
JPUSH_APP_KEY=YOUR_JPUSH_APP_KEY
JPUSH_MASTER_SECRET=YOUR_JPUSH_MASTER_SECRET

# ----------------------------------------------------------
# 服务提供者配置（公测环境）
# ----------------------------------------------------------
# 短信服务：mock（公测阶段暂时使用 mock，验证码固定 123456）
SMS_PROVIDER=mock

# 存储服务：minio（公测使用 MinIO 替代阿里云 OSS）
STORAGE_PROVIDER=minio

# 内容审核：local（公测使用本地关键词过滤，替代阿里云内容安全）
CONTENT_AUDIT_PROVIDER=local

# 推送服务：jpush（公测使用极光免费额度）
PUSH_PROVIDER=jpush

# AI 服务：zhipu（公测使用 GLM 免费额度）
AI_PROVIDER=zhipu

# ----------------------------------------------------------
# AI 配额配置
# ----------------------------------------------------------
# 普通用户每日AI对话配额
AI_DAILY_LIMIT=10
# VIP用户每日AI对话配额
AI_DAILY_LIMIT_VIP=100
# AI 对话免费配额（每日，业务层）
AI_FREE_QUOTA_DAILY=20
# 文案润色免费配额（每日）
POLISH_FREE_QUOTA_DAILY=5
# 情绪报告免费配额（每周）
REPORT_FREE_QUOTA_WEEKLY=1

# ----------------------------------------------------------
# 安全配置
# ----------------------------------------------------------
# 允许的 CORS 域名（根据实际部署域名修改）
CORS_ORIGINS=http://localhost,http://localhost:80,https://beta.huisheng.app

# IP 白名单（管理后台）
ADMIN_IP_WHITELIST=127.0.0.1,::1

# ----------------------------------------------------------
# 日志配置
# ----------------------------------------------------------
LOG_LEVEL=WARNING
LOG_FILE=/var/log/echo_meet/app.log

# ----------------------------------------------------------
# 业务配置
# ----------------------------------------------------------
MAX_FRIENDS_COUNT=500
