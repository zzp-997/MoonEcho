# ============================================================
# 回声（Echo Meet）环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ----------------------------------------------------------
# 环境设置
# ----------------------------------------------------------
# 环境：development / test / production
ENV=development
DEBUG=true

# ----------------------------------------------------------
# MySQL 配置
# ----------------------------------------------------------
MYSQL_ROOT_PASSWORD=echo_root_2026
MYSQL_USER=echo_app
MYSQL_PASSWORD=echo_app_2026
MYSQL_PORT=3306

# ----------------------------------------------------------
# Redis 配置
# ----------------------------------------------------------
# Redis 密码（可选，为空则不启用认证）
REDIS_PASSWORD=
REDIS_PORT=6379

# ----------------------------------------------------------
# JWT 配置
# ----------------------------------------------------------
# JWT 密钥（生产环境请使用强密钥：openssl rand -hex 32）
JWT_SECRET_KEY=echo_jwt_dev_secret_2026
# JWT 算法：HS256 或 RS256
JWT_ALGORITHM=HS256
# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=15
# 刷新令牌过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# MinIO 配置（测试环境对象存储）
# ----------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=echo-meet
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----------------------------------------------------------
# API 配置
# ----------------------------------------------------------
API_PORT=8000
API_WORKERS=4

# ----------------------------------------------------------
# Nginx 配置
# ----------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ----------------------------------------------------------
# Uptime Kuma 配置
# ----------------------------------------------------------
UPTIME_KUMA_PORT=3001

# ----------------------------------------------------------
# 第三方服务配置（生产环境填写）
# ----------------------------------------------------------

# 智谱 AI
ZHIPU_API_KEY=

# 阿里云 OSS（生产环境）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=

# 阿里云短信
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 阿里云内容安全
ALIYUN_CONTENT_AUDIT_ACCESS_KEY_ID=
ALIYUN_CONTENT_AUDIT_ACCESS_KEY_SECRET=

# 极光推送
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# ----------------------------------------------------------
# 服务提供者配置
# ----------------------------------------------------------
# 短信服务：mock / aliyun
SMS_PROVIDER=mock

# 存储服务：local / minio / aliyun_oss
STORAGE_PROVIDER=minio

# 内容审核：pass / local / aliyun
CONTENT_AUDIT_PROVIDER=pass

# 推送服务：mock / jpush
PUSH_PROVIDER=mock

# AI 服务：mock / zhipu
AI_PROVIDER=mock

# ----------------------------------------------------------
# 安全配置
# ----------------------------------------------------------
# 允许的 CORS 域名（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# IP 白名单（管理后台，逗号分隔）
ADMIN_IP_WHITELIST=127.0.0.1,::1

# ----------------------------------------------------------
# 日志配置
# ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=/var/log/echo_meet/app.log

# ----------------------------------------------------------
# 业务配置
# ----------------------------------------------------------
# 好友数量上限
MAX_FRIENDS_COUNT=500

# AI 对话免费配额（每日）
AI_FREE_QUOTA_DAILY=10

# 文案润色免费配额（每日）
POLISH_FREE_QUOTA_DAILY=3

# 情绪报告免费配额（每周）
REPORT_FREE_QUOTA_WEEKLY=1
